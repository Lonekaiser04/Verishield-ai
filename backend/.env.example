# Copy this file to .env and adjust as needed.

ENVIRONMENT=development
DEBUG=true

# When true, the system uses bundled synthetic demo scenarios and
# lightweight heuristic fallbacks where heavy ML models aren't installed.
DEMO_MODE=true

# --- Database ---
# SQLite (default, zero setup):
DATABASE_URL=sqlite:///./app/database/screening.db
# PostgreSQL (uncomment and edit to use instead):
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/verishield

# --- Storage ---
UPLOAD_DIR=./app/uploads_tmp
AUTO_DELETE_UPLOADS=true
MAX_UPLOAD_MB=15

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- OCR / CV ---
OCR_LANG=en
USE_GPU=false

# --- Face verification thresholds (percent similarity) ---
FACE_MATCH_THRESHOLD=70
FACE_REVIEW_THRESHOLD=50

# --- Risk engine weights (points out of 100; should sum to 100) ---
RISK_WEIGHT_OCR_CONFIDENCE=10
RISK_WEIGHT_VALIDATION=20
RISK_WEIGHT_EXPIRY=10
RISK_WEIGHT_TAMPERING=30
RISK_WEIGHT_FACE=15
RISK_WEIGHT_CROSS_DOC=15

RISK_LOW_MAX=30
RISK_MEDIUM_MAX=60

# --- Document classifier ---
CLASSIFIER_CONFIDENCE_THRESHOLD=0.55
